    {"files": ["web/src/lib/messageVisits.ts"], "rules": {"eslint/complexity": ["error", {"max": 11}], "eslint/max-depth": ["error", {"max": 4}]}},
    {"files": ["web/src/lib/stageGraph.ts"], "rules": {"eslint/complexity": ["error", {"max": 16}], "eslint/max-lines-per-function": ["error", {"max": 119, "skipBlankLines": true, "skipComments": true}]}},
    {"files": ["web/src/pages/GraphPage.tsx"], "rules": {"eslint/complexity": ["error", {"max": 21}], "eslint/max-lines-per-function": ["error", {"max": 164, "skipBlankLines": true, "skipComments": true}]}},
    {"files": ["web/src/pages/ImprovementsPage.tsx"], "rules": {"eslint/complexity": ["error", {"max": 19}]}},
    {"files": ["web/src/pages/NodePage.tsx"], "rules": {"eslint/complexity": ["error", {"max": 26}], "eslint/max-lines-per-function": ["error", {"max": 105, "skipBlankLines": true, "skipComments": true}]}},
    {"files": ["web/src/pages/ProcessPage.tsx"], "rules": {"eslint/complexity": ["error", {"max": 18}]}},
    {"files": ["web/src/pages/ProjectSettingsPage.tsx"], "rules": {"eslint/complexity": ["error", {"max": 12}]}},
    {"files": ["web/src/pages/node/MovingOn.tsx"], "rules": {"eslint/complexity": ["error", {"max": 16}]}},
    {"files": ["web/src/pages/node/Runs.tsx"], "rules": {"eslint/complexity": ["error", {"max": 12}]}}
  ]
}
