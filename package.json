{
  "name": "aop",
  "version": "0.0.0",
  "private": true,
  "description": "Agent orchestration platform",
  "type": "module",
  "bin": {
    "aop": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "plugin",
    "defaults"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/server/main.js",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "demo": "npm run build && tsx demo/start.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run",
    "test:server": "vitest run test/server",
    "test:web": "vitest run test/web",
    "test:cli": "vitest run test/cli test/defaults",
    "test:fast": "vitest run --exclude test/server/orchestrator.test.ts --exclude test/server/recovery.test.ts --exclude test/server/startup.test.ts --exclude test/cli/cli.test.ts --exclude test/cli/init.test.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@hono/node-server": "^2.1.6",
    "@xyflow/react": "^12.12.1",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
