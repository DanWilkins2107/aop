{
  "name": "aop",
  "version": "0.0.0",
  "private": true,
  "description": "Agent orchestration platform",
  "type": "module",
  "bin": {
    "aop": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "plugin",
    "defaults"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm install && npm run build && npm link && node dist/cli/main.js init --if-new",
    "start": "node dist/server/main.js",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web && npm run lint",
    "lint": "oxlint --type-aware --deny-warnings && knip",
    "test": "vitest run",
    "test:server": "vitest run test/server",
    "test:web": "vitest run test/web",
    "test:cli": "vitest run src/cli test/defaults",
    "test:fast": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@hono/mcp": "^0.3.5",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^12.12.1",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "knip": "^6.45.1",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
